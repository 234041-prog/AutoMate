<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AutoMate – احجز موعدك</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&family=Oxanium:wght@400;600;800&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --navy:#0a0f1e;--deep:#0d1b3e;
  --accent:#1e90ff;--accent2:#4fb3ff;
  --silver:#c8d6e5;--dim:#7a91a8;
  --white:#f0f6ff;--glow:rgba(30,144,255,.35);
  --card:rgba(13,27,62,.6);--border:rgba(30,144,255,.15);
  --green:#22c55e;--orange:#f59e0b;--red:#ef4444;
}
html{scroll-behavior:smooth}
body{font-family:'Cairo',sans-serif;background:var(--navy);color:var(--white);min-height:100vh;direction:rtl;overflow-x:hidden}

body::before{
  content:'';position:fixed;inset:0;
  background-image:linear-gradient(rgba(30,144,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(30,144,255,.05) 1px,transparent 1px);
  background-size:55px 55px;
  mask-image:radial-gradient(ellipse 100% 60% at 50% 0%,black 0%,transparent 100%);
  -webkit-mask-image:radial-gradient(ellipse 100% 60% at 50% 0%,black 0%,transparent 100%);
  pointer-events:none;z-index:0;
}

/* ── NAV ── */
nav{
  position:fixed;top:0;left:0;right:0;z-index:200;
  display:flex;justify-content:space-between;align-items:center;
  padding:1.1rem 4rem;
  background:rgba(10,15,30,.88);backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border);
}
.logo{font-family:'Oxanium',sans-serif;font-size:1.55rem;font-weight:800;color:var(--accent);letter-spacing:2px;text-decoration:none}
.logo span{color:var(--white)}
nav ul{list-style:none;display:flex;gap:2rem;align-items:center}
nav ul a{text-decoration:none;color:var(--dim);font-size:.9rem;font-weight:600;transition:color .3s}
nav ul a:hover{color:var(--accent)}
.nav-cta{background:var(--accent)!important;color:var(--navy)!important;padding:.45rem 1.2rem;border-radius:4px;font-weight:700!important}
.hamburger{display:none;flex-direction:column;gap:5px;background:transparent;border:none;cursor:pointer;padding:5px;z-index:300}
.hamburger span{display:block;width:24px;height:2px;background:var(--silver);border-radius:2px;transition:all .35s}
.hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg);background:var(--accent)}
.hamburger.open span:nth-child(2){opacity:0}
.hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);background:var(--accent)}
.nav-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:150}
.nav-overlay.open{display:block}

/* ── PAGE ── */
.page{position:relative;z-index:1;max-width:1200px;margin:0 auto;padding:7rem 2rem 5rem}

/* ── HEADER ── */
.page-header{text-align:center;margin-bottom:2.5rem;animation:fadeUp .6s ease both}
.page-tag{display:inline-block;font-family:'Oxanium',sans-serif;font-size:.72rem;letter-spacing:3px;text-transform:uppercase;color:var(--accent);margin-bottom:.6rem}
.page-header h1{font-size:clamp(1.8rem,4vw,2.8rem);font-weight:900;margin-bottom:.6rem}
.page-header p{color:var(--dim);font-size:1rem;line-height:1.7;max-width:520px;margin:0 auto}

/* ── AI SEARCH BAR ── */
.ai-search-wrap{max-width:680px;margin:0 auto 3rem;animation:fadeUp .6s .1s ease both}
.ai-search-label{font-size:.82rem;color:var(--accent2);font-weight:600;margin-bottom:.6rem;display:flex;align-items:center;gap:.4rem}
.ai-search-box{display:flex;gap:.7rem}
.ai-search-input{
  flex:1;background:var(--card);border:1px solid var(--border);
  border-radius:10px;color:var(--white);
  font-family:'Cairo',sans-serif;font-size:1rem;padding:.85rem 1.1rem;
  outline:none;transition:all .3s;
}
.ai-search-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(30,144,255,.1)}
.ai-search-input::placeholder{color:var(--dim)}
.ai-search-btn{
  background:var(--accent);color:var(--navy);border:none;
  border-radius:10px;padding:.85rem 1.5rem;
  font-family:'Cairo',sans-serif;font-size:.95rem;font-weight:700;
  cursor:pointer;transition:all .3s;white-space:nowrap;
  box-shadow:0 0 20px rgba(30,144,255,.3);
  display:flex;align-items:center;gap:.4rem;
}
.ai-search-btn:hover{transform:translateY(-2px);box-shadow:0 6px 30px rgba(30,144,255,.5)}
.ai-search-btn:disabled{opacity:.6;cursor:not-allowed;transform:none}
.ai-badge{
  display:inline-flex;align-items:center;gap:.35rem;
  background:rgba(30,144,255,.08);border:1px solid rgba(30,144,255,.2);
  color:var(--accent2);padding:.3rem .8rem;border-radius:20px;
  font-size:.78rem;font-weight:600;margin-top:.7rem;
}

/* ── FILTERS ── */
.filters-wrap{display:flex;gap:.7rem;flex-wrap:wrap;margin-bottom:2rem;animation:fadeUp .6s .15s ease both}
.filter-btn{
  background:var(--card);border:1px solid var(--border);
  color:var(--dim);padding:.45rem 1rem;border-radius:20px;
  font-family:'Cairo',sans-serif;font-size:.85rem;font-weight:600;
  cursor:pointer;transition:all .3s;
}
.filter-btn:hover{border-color:var(--accent);color:var(--accent)}
.filter-btn.active{background:rgba(30,144,255,.12);border-color:var(--accent);color:var(--accent)}
.filter-select{
  background:var(--card);border:1px solid var(--border);
  color:var(--silver);padding:.45rem 1rem;border-radius:20px;
  font-family:'Cairo',sans-serif;font-size:.85rem;
  cursor:pointer;outline:none;transition:all .3s;
}
.filter-select:focus{border-color:var(--accent)}
.filter-select option{background:#0d1b3e}

/* ── MAIN GRID ── */
.main-grid{display:grid;grid-template-columns:1fr 380px;gap:2rem;align-items:start}

/* ── WORKSHOPS LIST ── */
.workshops-section{}
.section-meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.2rem}
.section-meta h2{font-size:1.1rem;font-weight:700}
.count-badge{background:rgba(30,144,255,.1);color:var(--accent);padding:.2rem .7rem;border-radius:10px;font-size:.82rem;font-weight:700}

.workshop-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:14px;padding:1.4rem;margin-bottom:1.2rem;
  display:grid;grid-template-columns:90px 1fr auto;gap:1.2rem;align-items:center;
  cursor:pointer;transition:all .35s;position:relative;overflow:hidden;
}
.workshop-card::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(30,144,255,.05),transparent);
  opacity:0;transition:opacity .35s;
}
.workshop-card:hover{border-color:rgba(30,144,255,.4);transform:translateY(-3px);box-shadow:0 12px 40px rgba(30,144,255,.1)}
.workshop-card:hover::before{opacity:1}
.workshop-card.selected{border-color:var(--accent);background:rgba(30,144,255,.06)}
.workshop-card.selected::after{
  content:'✓ محدد';position:absolute;top:.8rem;left:.8rem;
  background:var(--accent);color:var(--navy);
  font-size:.72rem;font-weight:700;padding:.2rem .6rem;border-radius:10px;
  font-family:'Cairo',sans-serif;
}
.workshop-card.ai-recommended{border-color:rgba(34,197,94,.4)}
.recommended-tag{
  position:absolute;top:.8rem;right:.8rem;
  background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.3);
  color:var(--green);font-size:.72rem;font-weight:700;
  padding:.2rem .6rem;border-radius:10px;
  font-family:'Oxanium',sans-serif;
  display:flex;align-items:center;gap:.3rem;
}

.workshop-img{
  width:90px;height:80px;border-radius:8px;object-fit:cover;
  background:linear-gradient(135deg,rgba(30,144,255,.15),rgba(16,42,107,.4));
  display:flex;align-items:center;justify-content:center;
  font-size:2rem;flex-shrink:0;border:1px solid var(--border);
}
.workshop-info{min-width:0}
.workshop-name{font-size:1.05rem;font-weight:700;margin-bottom:.3rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.workshop-specialty{color:var(--accent2);font-size:.82rem;font-weight:600;margin-bottom:.5rem}
.workshop-meta-row{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}
.meta-item{display:flex;align-items:center;gap:.3rem;color:var(--dim);font-size:.8rem}
.stars{color:#f59e0b;font-size:.85rem;letter-spacing:1px}
.rating-num{color:var(--white);font-weight:700;font-size:.85rem}
.hours-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.hours-dot.open{background:var(--green)}
.hours-dot.closed{background:var(--red)}
.workshop-price{text-align:center;flex-shrink:0}
.price-from{font-size:.72rem;color:var(--dim)}
.price-val{font-family:'Oxanium',sans-serif;font-size:1.2rem;font-weight:800;color:var(--accent);line-height:1.1}
.price-currency{font-size:.72rem;color:var(--dim)}
.select-btn{
  margin-top:.5rem;background:transparent;border:1px solid var(--border);
  color:var(--dim);border-radius:6px;padding:.35rem .8rem;
  font-family:'Cairo',sans-serif;font-size:.8rem;cursor:pointer;transition:all .3s;
  white-space:nowrap;
}
.select-btn:hover{border-color:var(--accent);color:var(--accent)}
.workshop-card.selected .select-btn{background:var(--accent);color:var(--navy);border-color:var(--accent);font-weight:700}

/* loading skeleton */
.skeleton{animation:shimmer 1.5s infinite}
.skel-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.4rem;margin-bottom:1.2rem;height:110px}
@keyframes shimmer{0%,100%{opacity:.5}50%{opacity:1}}

/* ── BOOKING FORM ── */
.booking-panel{
  background:var(--card);border:1px solid var(--border);
  border-radius:16px;padding:1.8rem;
  position:sticky;top:7rem;
  backdrop-filter:blur(12px);
  animation:fadeUp .6s .2s ease both;
}
.panel-title{font-size:1.05rem;font-weight:700;color:var(--accent2);margin-bottom:1.5rem;display:flex;align-items:center;gap:.5rem}
.selected-workshop-preview{
  background:rgba(30,144,255,.06);border:1px solid rgba(30,144,255,.2);
  border-radius:10px;padding:.9rem 1rem;margin-bottom:1.3rem;
  display:none;
}
.selected-workshop-preview.show{display:block}
.preview-name{font-weight:700;font-size:.95rem;margin-bottom:.2rem}
.preview-spec{color:var(--accent2);font-size:.8rem}

.form-group{margin-bottom:1rem}
.form-group label{display:block;font-size:.82rem;font-weight:600;color:var(--silver);margin-bottom:.4rem}
.form-group label span{color:var(--red)}
.form-input,.form-select,.form-textarea{
  width:100%;background:rgba(10,15,30,.6);border:1px solid var(--border);
  border-radius:8px;color:var(--white);font-family:'Cairo',sans-serif;
  font-size:.92rem;padding:.75rem 1rem;outline:none;transition:all .3s;
}
.form-input:focus,.form-select:focus,.form-textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(30,144,255,.1)}
.form-input::placeholder,.form-textarea::placeholder{color:var(--dim)}
.form-select{cursor:pointer;appearance:none}
.form-select option{background:#0d1b3e}
.form-textarea{resize:vertical;min-height:80px;line-height:1.6}

.time-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-top:.4rem}
.time-slot{
  background:rgba(10,15,30,.5);border:1px solid var(--border);
  border-radius:6px;padding:.4rem;text-align:center;
  font-family:'Cairo',sans-serif;font-size:.8rem;color:var(--dim);
  cursor:pointer;transition:all .3s;
}
.time-slot:hover{border-color:var(--accent);color:var(--accent)}
.time-slot.selected{background:rgba(30,144,255,.12);border-color:var(--accent);color:var(--accent);font-weight:700}
.time-slot.busy{opacity:.3;cursor:not-allowed;text-decoration:line-through}

.book-btn{
  width:100%;padding:.95rem;border:none;border-radius:8px;
  background:var(--accent);color:var(--navy);
  font-family:'Cairo',sans-serif;font-size:1rem;font-weight:700;
  cursor:pointer;transition:all .3s;margin-top:1rem;
  box-shadow:0 0 20px rgba(30,144,255,.3);
  display:flex;align-items:center;justify-content:center;gap:.5rem;
}
.book-btn:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 6px 30px rgba(30,144,255,.5)}
.book-btn:disabled{opacity:.45;cursor:not-allowed;transform:none}

/* ── SUCCESS ── */
.success-overlay{
  display:none;position:fixed;inset:0;
  background:rgba(0,0,0,.7);backdrop-filter:blur(8px);
  z-index:500;align-items:center;justify-content:center;
}
.success-overlay.show{display:flex}
.success-modal{
  background:linear-gradient(135deg,#0d1b3e,#0a0f1e);
  border:1px solid rgba(30,144,255,.25);border-radius:20px;
  padding:3rem 2.5rem;text-align:center;max-width:420px;width:90%;
  animation:popIn .4s cubic-bezier(.34,1.56,.64,1) both;
}
@keyframes popIn{from{transform:scale(.8);opacity:0}to{transform:scale(1);opacity:1}}
.success-ring{
  width:90px;height:90px;margin:0 auto 1.5rem;border-radius:50%;
  background:rgba(34,197,94,.1);border:2px solid rgba(34,197,94,.4);
  display:flex;align-items:center;justify-content:center;font-size:2.2rem;
}
.success-modal h2{font-size:1.6rem;font-weight:900;margin-bottom:.6rem}
.success-modal p{color:var(--dim);line-height:1.7;font-size:.95rem}
.booking-ref{
  background:rgba(30,144,255,.08);border:1px solid rgba(30,144,255,.2);
  border-radius:8px;padding:.8rem;margin:1.2rem 0;
  font-family:'Oxanium',sans-serif;font-size:1.1rem;
  font-weight:800;color:var(--accent);letter-spacing:2px;
}
.close-success{
  background:var(--accent);color:var(--navy);border:none;
  border-radius:8px;padding:.8rem 2rem;
  font-family:'Cairo',sans-serif;font-size:.95rem;font-weight:700;
  cursor:pointer;margin-top:.5rem;transition:all .3s;
}
.close-success:hover{box-shadow:0 0 20px rgba(30,144,255,.4)}

/* ── EMPTY STATE ── */
.empty-state{text-align:center;padding:3rem 1rem;color:var(--dim)}
.empty-icon{font-size:3rem;margin-bottom:1rem}

@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}

/* ── AI THINKING ── */
.ai-thinking{
  display:none;background:rgba(30,144,255,.06);border:1px solid rgba(30,144,255,.2);
  border-radius:10px;padding:1rem;margin-bottom:1.5rem;
  align-items:center;gap:.8rem;font-size:.9rem;color:var(--accent2);
}
.ai-thinking.show{display:flex}
.ai-spin{animation:spin 1s linear infinite;font-size:1.1rem}
@keyframes spin{to{transform:rotate(360deg)}}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  nav{padding:1rem 1.5rem}
  .hamburger{display:flex}
  nav ul{
    flex-direction:column;position:fixed;
    top:0;right:-100%;width:78%;max-width:300px;height:100vh;
    background:rgba(8,13,26,.98);backdrop-filter:blur(24px);
    border-left:1px solid var(--border);
    padding:5.5rem 1.8rem 2rem;gap:0;
    transition:right .38s cubic-bezier(.4,0,.2,1);z-index:250;align-items:flex-start;
  }
  nav ul.open{right:0}
  nav ul li{width:100%}
  nav ul li a{display:block;padding:.85rem 0;font-size:1.05rem;border-bottom:1px solid rgba(30,144,255,.08);color:var(--silver)}
  .main-grid{grid-template-columns:1fr}
  .booking-panel{position:static}
  .page{padding:6rem 1rem 3rem}
}
@media(max-width:600px){
  .workshop-card{grid-template-columns:70px 1fr;gap:.8rem}
  .workshop-price{display:none}
  .workshop-img{width:70px;height:65px}
  .time-grid{grid-template-columns:repeat(2,1fr)}
  .ai-search-box{flex-direction:column}
}
</style>
</head>
<body>

<div class="nav-overlay" id="navOverlay" onclick="closeMenu()"></div>

<!-- NAV -->
<nav>
  <a class="logo" href="automate-landing.html">Auto<span>Mate</span></a>
  <ul id="navMenu">
    <li><a href="automate-landing.html#how" onclick="closeMenu()">كيف يعمل</a></li>
    <li><a href="automate-landing.html#why" onclick="closeMenu()">لماذا نحن</a></li>
    <li><a href="automate-diagnosis.html" onclick="closeMenu()">التشخيص</a></li>
    <li><a href="automate-contact.html" onclick="closeMenu()">تواصل معنا</a></li>
    <li><a href="automate-booking.html" class="nav-cta" onclick="closeMenu()">احجز موعد</a></li>
  </ul>
  <button class="hamburger" id="hamburger" onclick="toggleMenu()">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="page">

  <!-- HEADER -->
  <div class="page-header">
    <div class="page-tag">📅 حجز المواعيد</div>
    <h1>احجز في محطة الصيانة المناسبة</h1>
    <p>اكتب مشكلتك وسيقترح الذكاء الاصطناعي أفضل المحطات المتاحة، ثم اختر وأكد حجزك مباشرة.</p>
  </div>

  <!-- AI SEARCH -->
  <div class="ai-search-wrap">
    <div class="ai-search-label">🤖 اكتب مشكلتك وسيقترح AI أفضل المحطات</div>
    <div class="ai-search-box">
      <input type="text" id="aiQuery" class="ai-search-input"
        placeholder="مثال: صوت غريب من المحرك، أو تغيير زيت، أو إطارات...">
      <button class="ai-search-btn" id="aiSearchBtn" onclick="aiSearch()">
        🔍 اقتراح محطات
      </button>
    </div>
    <div id="aiBadge" class="ai-badge" style="display:none">
      ✨ تم تحليل مشكلتك — المحطات المقترحة مرتبة حسب التخصص والتقييم
    </div>
  </div>

  <!-- AI THINKING -->
  <div class="ai-thinking" id="aiThinking">
    <span class="ai-spin">⚙️</span>
    <span>يتم تحليل مشكلتك واختيار أفضل المحطات...</span>
  </div>

  <!-- FILTERS -->
  <div class="filters-wrap" id="filtersWrap">
    <button class="filter-btn active" onclick="filterCat(this,'all')">الكل</button>
    <button class="filter-btn" onclick="filterCat(this,'engine')">محرك</button>
    <button class="filter-btn" onclick="filterCat(this,'tires')">إطارات وفرامل</button>
    <button class="filter-btn" onclick="filterCat(this,'electric')">كهرباء</button>
    <button class="filter-btn" onclick="filterCat(this,'body')">هيكل وطلاء</button>
    <button class="filter-btn" onclick="filterCat(this,'ac')">تكييف</button>
    <select class="filter-select" onchange="filterRating(this.value)">
      <option value="0">كل التقييمات</option>
      <option value="4.5">4.5 ⭐ فأعلى</option>
      <option value="4">4 ⭐ فأعلى</option>
    </select>
    <select class="filter-select" onchange="filterDistance(this.value)">
      <option value="99">كل المسافات</option>
      <option value="2">أقل من 2 كم</option>
      <option value="5">أقل من 5 كم</option>
      <option value="10">أقل من 10 كم</option>
    </select>
  </div>

  <!-- MAIN GRID -->
  <div class="main-grid">

    <!-- WORKSHOPS -->
    <div class="workshops-section">
      <div class="section-meta">
        <h2>محطات الصيانة المتاحة</h2>
        <span class="count-badge" id="countBadge">6 محطات</span>
      </div>
      <div id="workshopsList"></div>
    </div>

    <!-- BOOKING PANEL -->
    <div class="booking-panel">
      <div class="panel-title">📋 تفاصيل الحجز</div>

      <div class="selected-workshop-preview" id="selectedPreview">
        <div class="preview-name" id="previewName">—</div>
        <div class="preview-spec" id="previewSpec">—</div>
      </div>

      <div class="form-group">
        <label>نوع الخدمة <span>*</span></label>
        <select id="fService" class="form-select">
          <option value="" disabled selected>اختر نوع الخدمة</option>
          <option>🔧 تغيير زيت وفلتر</option>
          <option>🛞 تغيير أو توازن إطارات</option>
          <option>🔋 صيانة كهربائية</option>
          <option>❄️ صيانة تكييف</option>
          <option>🏎️ صيانة محرك</option>
          <option>🎨 هيكل وطلاء</option>
          <option>🔍 فحص شامل</option>
          <option>⚙️ أخرى</option>
        </select>
      </div>

      <div class="form-group">
        <label>التاريخ <span>*</span></label>
        <input type="date" id="fDate" class="form-input" onchange="loadTimeSlots()">
      </div>

      <div class="form-group">
        <label>الوقت المتاح <span>*</span></label>
        <div class="time-grid" id="timeGrid">
          <div style="color:var(--dim);font-size:.82rem;grid-column:1/-1">اختر تاريخاً أولاً</div>
        </div>
      </div>

      <div class="form-group">
        <label>ملاحظات إضافية</label>
        <textarea id="fNotes" class="form-textarea" placeholder="أي تفاصيل إضافية عن المشكلة..."></textarea>
      </div>

      <button class="book-btn" id="bookBtn" onclick="submitBooking()" disabled>
        📅 تأكيد الحجز
      </button>
    </div>
  </div>
</div>

<!-- SUCCESS MODAL -->
<div class="success-overlay" id="successOverlay">
  <div class="success-modal">
    <div class="success-ring">✓</div>
    <h2>تم الحجز بنجاح!</h2>
    <p>موعدك مؤكد. ستصلك رسالة تأكيد قريباً.</p>
    <div class="booking-ref" id="bookingRef">AM-000000</div>
    <div id="bookingSummary" style="color:var(--dim);font-size:.88rem;line-height:1.8;margin-bottom:.5rem"></div>
    <button class="close-success" onclick="closeSuccess()">عودة للصفحة</button>
  </div>
</div>

<script>
// ── DATA ──────────────────────────────────────────────────────────────────
const ALL_WORKSHOPS = [
  {
    id:1, name:'محطة النور للصيانة', emoji:'🔧',
    specialty:'صيانة شاملة ومحرك',
    cats:['engine','all'],
    rating:4.9, reviews:312,
    distance:1.2, distanceText:'1.2 كم',
    hours:'8ص – 7م', isOpen:true,
    priceFrom:80, currency:'₪',
    phone:'059-000-0001',
    recommended:false
  },
  {
    id:2, name:'مركز البراق للإطارات',emoji:'🛞',
    specialty:'إطارات وفرامل متخصص',
    cats:['tires','all'],
    rating:4.7, reviews:198,
    distance:2.4, distanceText:'2.4 كم',
    hours:'8ص – 6م', isOpen:true,
    priceFrom:60, currency:'₪',
    phone:'059-000-0002',
    recommended:false
  },
  {
    id:3, name:'ورشة الخبراء الكهربائية',emoji:'⚡',
    specialty:'كهرباء وإلكترونيات السيارة',
    cats:['electric','all'],
    rating:4.8, reviews:245,
    distance:3.1, distanceText:'3.1 كم',
    hours:'9ص – 5م', isOpen:true,
    priceFrom:100, currency:'₪',
    phone:'059-000-0003',
    recommended:false
  },
  {
    id:4, name:'مركز البستان للطلاء',emoji:'🎨',
    specialty:'هيكل وطلاء احترافي',
    cats:['body','all'],
    rating:4.6, reviews:142,
    distance:4.8, distanceText:'4.8 كم',
    hours:'8ص – 4م', isOpen:false,
    priceFrom:150, currency:'₪',
    phone:'059-000-0004',
    recommended:false
  },
  {
    id:5, name:'محطة فلسطين للخدمات',emoji:'🏪',
    specialty:'خدمات متكاملة وتكييف',
    cats:['ac','engine','all'],
    rating:4.5, reviews:289,
    distance:1.8, distanceText:'1.8 كم',
    hours:'7ص – 8م', isOpen:true,
    priceFrom:70, currency:'₪',
    phone:'059-000-0005',
    recommended:false
  },
  {
    id:6, name:'مركز الوفاء السريع',emoji:'⚙️',
    specialty:'صيانة سريعة وزيت',
    cats:['engine','all'],
    rating:4.4, reviews:176,
    distance:0.9, distanceText:'0.9 كم',
    hours:'8ص – 9م', isOpen:true,
    priceFrom:50, currency:'₪',
    phone:'059-000-0006',
    recommended:false
  }
];

let workshops = JSON.parse(JSON.stringify(ALL_WORKSHOPS));
let selectedId = null;
let selectedTime = null;
let activeCat = 'all';
let minRating = 0;
let maxDist = 99;

// ── RENDER ────────────────────────────────────────────────────────────────
function renderWorkshops(list) {
  const el = document.getElementById('workshopsList');
  document.getElementById('countBadge').textContent = list.length + ' محطات';
  if(!list.length) {
    el.innerHTML = `<div class="empty-state"><div class="empty-icon">🔍</div><p>لا توجد محطات تطابق البحث</p></div>`;
    return;
  }
  el.innerHTML = list.map(w => {
    const stars = '★'.repeat(Math.floor(w.rating)) + (w.rating%1>=.5?'½':'');
    return `
    <div class="workshop-card${selectedId===w.id?' selected':''}${w.recommended?' ai-recommended':''}"
         id="wcard${w.id}" onclick="selectWorkshop(${w.id})">
      ${w.recommended ? '<div class="recommended-tag">🤖 مقترح AI</div>' : ''}
      <div class="workshop-img">${w.emoji}</div>
      <div class="workshop-info">
        <div class="workshop-name">${w.name}</div>
        <div class="workshop-specialty">${w.specialty}</div>
        <div class="workshop-meta-row">
          <div class="meta-item">
            <span class="stars">${'★'.repeat(Math.floor(w.rating))}</span>
            <span class="rating-num">${w.rating}</span>
            <span style="color:var(--dim);font-size:.75rem">(${w.reviews})</span>
          </div>
          <div class="meta-item">📍 ${w.distanceText}</div>
          <div class="meta-item">
            <span class="hours-dot ${w.isOpen?'open':'closed'}"></span>
            <span>${w.isOpen?'مفتوح الآن':'مغلق'}</span>
          </div>
          <div class="meta-item">🕐 ${w.hours}</div>
        </div>
      </div>
      <div class="workshop-price">
        <div class="price-from">يبدأ من</div>
        <div class="price-val">${w.priceFrom}</div>
        <div class="price-currency">${w.currency}</div>
        <button class="select-btn" onclick="event.stopPropagation();selectWorkshop(${w.id})">
          ${selectedId===w.id?'✓ محدد':'اختر'}
        </button>
      </div>
    </div>`;
  }).join('');
}

// ── SELECT ────────────────────────────────────────────────────────────────
function selectWorkshop(id) {
  selectedId = id;
  const w = workshops.find(x=>x.id===id);
  document.getElementById('selectedPreview').classList.add('show');
  document.getElementById('previewName').textContent = w.name;
  document.getElementById('previewSpec').textContent = w.specialty + ' · ' + w.distanceText;
  renderWorkshops(getFiltered());
  checkBookBtn();
}

// ── TIME SLOTS ────────────────────────────────────────────────────────────
const BUSY = ['10:00','14:00','16:00'];
function loadTimeSlots() {
  const date = document.getElementById('fDate').value;
  if(!date) return;
  selectedTime = null;
  const slots = ['08:00','09:00','10:00','11:00','12:00','13:00','14:00','15:00','16:00','17:00','18:00','19:00'];
  document.getElementById('timeGrid').innerHTML = slots.map(t => `
    <div class="time-slot${BUSY.includes(t)?' busy':''}" onclick="${BUSY.includes(t)?'':'selectTime(this,\''+t+'\')'}">${t}</div>
  `).join('');
  checkBookBtn();
}

function selectTime(el, t) {
  document.querySelectorAll('.time-slot').forEach(x=>x.classList.remove('selected'));
  el.classList.add('selected');
  selectedTime = t;
  checkBookBtn();
}

// ── VALIDATION ────────────────────────────────────────────────────────────
function checkBookBtn() {
  const ok = selectedId && selectedTime && document.getElementById('fDate').value && document.getElementById('fService').value;
  document.getElementById('bookBtn').disabled = !ok;
}
document.getElementById('fService').addEventListener('change', checkBookBtn);

// ── FILTERS ──────────────────────────────────────────────────────────────
function getFiltered() {
  return workshops.filter(w =>
    (activeCat==='all' || w.cats.includes(activeCat)) &&
    w.rating >= minRating &&
    w.distance <= maxDist
  );
}
function filterCat(btn, cat) {
  activeCat = cat;
  document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  renderWorkshops(getFiltered());
}
function filterRating(val) { minRating = parseFloat(val); renderWorkshops(getFiltered()); }
function filterDistance(val) { maxDist = parseFloat(val); renderWorkshops(getFiltered()); }

// ── AI SEARCH ─────────────────────────────────────────────────────────────
async function aiSearch() {
  const q = document.getElementById('aiQuery').value.trim();
  if(!q) return;
  const btn = document.getElementById('aiSearchBtn');
  btn.disabled = true;
  btn.textContent = '⏳ جاري التحليل...';
  document.getElementById('aiThinking').classList.add('show');
  document.getElementById('aiBadge').style.display = 'none';

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method:'POST',
      headers:{
        'Content-Type':'application/json',
        'anthropic-version':'2023-06-01',
        'anthropic-dangerous-direct-browser-access':'true'
      },
      body: JSON.stringify({
        model:'claude-opus-4-5',
        max_tokens:400,
        system:`أنت مساعد متخصص في صيانة السيارات. المستخدم يصف مشكلة سيارته.
حدد أي من هذه الفئات تناسب المشكلة (يمكن أكثر من واحدة):
engine, tires, electric, body, ac

أجب بـ JSON فقط بدون أي نص خارجه:
{"categories":["engine"],"reason":"سبب مختصر جداً بالعربية"}`,
        messages:[{role:'user',content:'مشكلة السيارة: '+q}]
      })
    });
    const data = await res.json();
    const txt = (data.content||[]).map(b=>b.text||'').join('').replace(/```json|```/g,'').trim();
    const parsed = JSON.parse(txt);

    // reset recommendations
    workshops = JSON.parse(JSON.stringify(ALL_WORKSHOPS));

    // mark recommended
    workshops.forEach(w => {
      w.recommended = parsed.categories.some(c => w.cats.includes(c));
    });

    // sort: recommended first
    workshops.sort((a,b) => (b.recommended-a.recommended) || (b.rating-a.rating));

    // set filter
    if(parsed.categories.length===1) {
      activeCat = parsed.categories[0];
      document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
      const matchBtn = [...document.querySelectorAll('.filter-btn')].find(b=>b.getAttribute('onclick')?.includes(activeCat));
      if(matchBtn) matchBtn.classList.add('active');
    } else {
      activeCat = 'all';
      document.querySelectorAll('.filter-btn').forEach((b,i)=>{ if(i===0) b.classList.add('active'); else b.classList.remove('active'); });
    }

    document.getElementById('aiThinking').classList.remove('show');
    document.getElementById('aiBadge').style.display = 'inline-flex';
    renderWorkshops(getFiltered());

  } catch(e) {
    // fallback — show all
    document.getElementById('aiThinking').classList.remove('show');
    renderWorkshops(getFiltered());
  }

  btn.disabled = false;
  btn.innerHTML = '🔍 اقتراح محطات';
}

// Enter key on search
document.getElementById('aiQuery').addEventListener('keydown', e => { if(e.key==='Enter') aiSearch(); });

// ── SUBMIT ────────────────────────────────────────────────────────────────
function submitBooking() {
  const w = workshops.find(x=>x.id===selectedId);
  const service = document.getElementById('fService').value;
  const date = document.getElementById('fDate').value;
  const ref = 'AM-' + Math.floor(100000+Math.random()*900000);
  document.getElementById('bookingRef').textContent = ref;
  document.getElementById('bookingSummary').innerHTML =
    `<strong>المحطة:</strong> ${w.name}<br>
     <strong>الخدمة:</strong> ${service}<br>
     <strong>الموعد:</strong> ${date} — ${selectedTime}`;
  document.getElementById('successOverlay').classList.add('show');
}

function closeSuccess() {
  document.getElementById('successOverlay').classList.remove('show');
  // reset
  selectedId = null; selectedTime = null;
  document.getElementById('selectedPreview').classList.remove('show');
  document.getElementById('fService').selectedIndex = 0;
  document.getElementById('fDate').value = '';
  document.getElementById('fNotes').value = '';
  document.getElementById('timeGrid').innerHTML = '<div style="color:var(--dim);font-size:.82rem;grid-column:1/-1">اختر تاريخاً أولاً</div>';
  document.getElementById('bookBtn').disabled = true;
  workshops = JSON.parse(JSON.stringify(ALL_WORKSHOPS));
  renderWorkshops(getFiltered());
}

// ── NAV ───────────────────────────────────────────────────────────────────
function toggleMenu() {
  document.getElementById('navMenu').classList.toggle('open');
  document.getElementById('hamburger').classList.toggle('open');
  document.getElementById('navOverlay').classList.toggle('open');
  document.body.style.overflow = document.getElementById('navMenu').classList.contains('open')?'hidden':'';
}
function closeMenu() {
  document.getElementById('navMenu').classList.remove('open');
  document.getElementById('hamburger').classList.remove('open');
  document.getElementById('navOverlay').classList.remove('open');
  document.body.style.overflow='';
}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeMenu()});

// ── SET MIN DATE ──────────────────────────────────────────────────────────
document.getElementById('fDate').min = new Date().toISOString().split('T')[0];

// ── INIT ──────────────────────────────────────────────────────────────────
renderWorkshops(workshops);
</script>
</body>
</html>
